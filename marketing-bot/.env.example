PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ADMIN_KEY=replace-with-a-long-random-value

# YWP OS connection. Point this at the same backend used by the mobile app.
YWP_OS_API_BASE_URL=https://ywp-os-api.onrender.com
YWP_OS_MARKETING_FEED_PATH=/api/v1/marketing/approved-cards
YWP_OS_API_TOKEN=

# Safe default: publishing stays disabled until all Meta fields are configured.
IG_PUBLISH_ENABLED=false
IG_USER_ID=
IG_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# America/New_York is the canonical YWP slate timezone.
YWP_TIMEZONE=America/New_York

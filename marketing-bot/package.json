{
  "name": "ywp-os-marketing-bot",
  "version": "0.1.0",
  "private": true,
  "description": "One-tap / scheduled Instagram promo bot for YWP OS (no per-post verify).",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "preview": "node --import tsx scripts/generate-preview.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "sharp": "^0.34.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

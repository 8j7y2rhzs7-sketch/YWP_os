# Core
YWP_ENV=development
YWP_DEMO_MODE=true
YWP_JWT_SECRET=replace-with-at-least-32-random-characters
YWP_ACCESS_TOKEN_MINUTES=30
YWP_REFRESH_TOKEN_DAYS=30
YWP_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Infrastructure
DATABASE_URL=postgresql+psycopg://ywp:ywp@localhost:5432/ywp
REDIS_URL=redis://localhost:6379/0

# External providers (optional in demo mode)
# For live MLB moneylines/totals/run lines, set a real key from the-odds-api.com
# Do NOT use placeholders like "-" — leave blank or set the real key.
OPENAI_API_KEY=
SPORTS_DATA_API_KEY=
ODDS_API_KEY=
MLB_STATS_API_KEY=
WEATHER_API_KEY=
MARKETS_DATA_API_KEY=
CRYPTO_DATA_API_KEY=
PUSH_NOTIFICATION_KEY=

# Whop — existing DECISION ENGINE product (do not create a new product/plan)
WHOP_COMPANY_ID=biz_bJ27sV6ImlZZmj
WHOP_PRODUCT_ID=prod_NuPQUAGoibkpW
WHOP_PLAN_ID=plan_MwJ2qcFxmvqDY
NEXT_PUBLIC_WHOP_CHECKOUT_URL=https://whop.com/checkout/plan_MwJ2qcFxmvqDY
WHOP_CHECKOUT_URL=https://whop.com/checkout/plan_MwJ2qcFxmvqDY
WHOP_SUBSCRIPTION_REQUIRED=true
YWP_APP_DOWNLOAD_URL=https://github.com/8j7y2rhzs7-sketch/YWP_os/releases/download/android-v3.3.7/YWP-OS-3.3.7.apk

# Generate these in Whop Dashboard → Developer. Do not paste them into chat.
